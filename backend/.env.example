APP_NAME=ManicERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZW
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Africa/Harare

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Central (platform) database: council directory, identity, memberships, sessions, queues.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=manicerp_central
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# Tenant connection template. The concrete database name always comes from the
# server-side council directory; never accept one from a client.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5433
TENANT_DB_USERNAME=postgres
TENANT_DB_PASSWORD=
TENANT_DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=manicerp

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@manicerp.local"
MAIL_FROM_NAME="${APP_NAME}"

# Private document storage. Never expose this path through the web server.
DOCUMENTS_DISK=documents

# Allow signed-in users to select among their own councils in local development.
# Set false in production and resolve councils by verified host.
TENANCY_ALLOW_SESSION_SELECTION=true

# AI is disabled by default. No provider key belongs in git.
AI_ENABLED=false
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
AI_MONTHLY_BUDGET_MINOR=0
AI_COST_PER_1K_TOKENS_MINOR=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Sandbox payment adapter (clearly labelled; no real money movement).
PAYMENTS_DEFAULT_GATEWAY=sandbox
PAYMENTS_SANDBOX_WEBHOOK_SECRET=change-me-before-use

DEMO_PASSWORD=Demo!Pass2026
